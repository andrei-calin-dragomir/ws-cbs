						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"    ",
							"    id = pm.response.json().id;",
							"",
							"    pm.collectionVariables.set(\"generatedId\", id);",
